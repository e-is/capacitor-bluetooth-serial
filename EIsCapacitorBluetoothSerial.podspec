require 'json'

package = JSON.parse(File.read(File.join(__dir__, 'package.json')))

# The pod name must match the name generated by the Capacitor CLI from the npm package name
# ('@e-is/capacitor-bluetooth-serial' -> 'EIsCapacitorBluetoothSerial'), otherwise 'pod install' fails
Pod::Spec.new do |s|
  s.name = 'EIsCapacitorBluetoothSerial'
  s.version = package['version']
  s.summary = package['description']
  s.license = package['license']
  s.homepage = 'https://github.com/e-is/capacitor-bluetooth-serial'
  s.author = package['author']
  s.source = { :git => 'https://github.com/e-is/capacitor-bluetooth-serial.git', :tag => s.version.to_s }
  s.source_files = 'ios/Plugin/**/*.{swift,h,m,c,cc,mm,cpp}'
  s.ios.deployment_target = '15.0'
  s.dependency 'Capacitor'
  s.swift_version = '5.1'
end
